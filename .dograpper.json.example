{
  "download": {
    "downloader": "wget",
    "depth": 3,
    "include-extensions": "html,md",
    "manifest": ".dograpper-manifest.json",
    "header": [],
    "cookies": null,
    "browser-headers": true
  },
  "pack": {
    "max-words-per-chunk": 400000,
    "max-chunks": 50,
    "strategy": "semantic",
    "format": "md",
    "with-index": true
  }
}
